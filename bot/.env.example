# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Kraken pair. XMRUSD, XMREUR, XMRXBT all work.
PAIR=XMRUSD

# Seconds between nickname updates. 30 is a safe default; 10 is about the floor
# before Discord starts answering 429 on the nickname route.
NICK_INTERVAL=30

# Seconds between presence (status line) updates. Discord allows 5 per 20 s.
PRESENCE_INTERVAL=15
