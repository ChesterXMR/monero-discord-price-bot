# systemd unit for a Linux VM (Oracle / GCP / any VPS).
# 1. sudo cp monero-price-bot.service /etc/systemd/system/
# 2. edit User= and WorkingDirectory= below
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now monero-price-bot
# 4. journalctl -u monero-price-bot -f
[Unit]
Description=Monero Discord price bot
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/monero-discord-price-bot/bot
EnvironmentFile=/home/ubuntu/monero-discord-price-bot/bot/.env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
